<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Both only used when the weather option is on (SettingsActivity asks for the location then):
         the TV's rough location, sent rounded to about 1 km to Open-Meteo. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:supportsRtl="true">
        <service android:name=".GoalService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled football score monitoring and goal overlays on Android TV" />
        </service>
        <activity android:name=".SportsSettingsActivity" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver android:name=".FootballBoot" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>

        <!-- `settings put secure screensaver_components com.gathin.personalphotos/.PhotoDream` (sync.sh does it). -->
        <service
            android:name=".PhotoDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- The card on cleanyourtv's Home (docs/modules.md): the slideshow at once, Back to leave. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Opened by the TV's screensaver settings (xml/dream.xml), which needs it exported. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- sync.sh writes the pictures through this: on TCL G10 a file the shell copies into Android/data
             belongs to the shell and the app gets EACCES reading it. WRITE_SECURE_SETTINGS: the adb shell has
             it, ordinary apps don't. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.gathin.personalphotos.files"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
