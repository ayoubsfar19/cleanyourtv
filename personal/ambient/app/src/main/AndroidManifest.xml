<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Wi-Fi identity is read locally; weather uses the chosen public city coordinates. -->
    <permission android:name="com.gathin.ambienttv.permission.RECOMMENDATIONS" android:protectionLevel="signature" />
    <uses-permission android:name="com.gathin.ambienttv.permission.RECOMMENDATIONS" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:ignore="CoarseFineLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:supportsRtl="true">

        <provider android:name=".RecommendationsProvider" android:authorities="com.gathin.ambienttv.recommendations" android:exported="true" android:readPermission="com.gathin.ambienttv.permission.RECOMMENDATIONS" />
        <activity android:name=".RecommendationsProbeActivity" android:exported="true" android:permission="android.permission.WRITE_SECURE_SETTINGS" android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".HomeBackService"
            android:label="@string/home_back_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/home_back_service" />
        </service>

        <!-- `settings put secure screensaver_components com.gathin.ambienttv/.PhotoDream` (sync.sh does it). -->
        <service
            android:name=".PhotoDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- The card on cleanyourtv's Home (docs/modules.md): the slideshow at once, Back to leave. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Opened by the TV's screensaver settings (xml/dream.xml), which needs it exported. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- sync.sh writes the pictures through this: on TCL G10 a file the shell copies into Android/data
             belongs to the shell and the app gets EACCES reading it. WRITE_SECURE_SETTINGS: the adb shell has
             it, ordinary apps don't. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.gathin.ambienttv.files"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
